[node name="RichTextLabel" type="RichTextLabel" parent="Info"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 20
bbcode_enabled = true
text = "Земля здесь дрожит от грохота кузницы, где плавятся металл. Дороги — это трещины в почве, заполненные чем попало дабы дороги не размывало ещё сильней. Публичная звероферма «Живой Грот» выставляет на продажу не только обычный скот. Здесь власть кланов настолько мала из-за бандитов, готовых выскочить из тёмных переулков домов, что стража то и дело попадет в стычки пытаясь удержать хоть какой-то порядок на улицах."

